# Supabase Configuration (supports either Next.js standard or Supabase Publishable/Secret keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases (automatically supported on server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Application URL (used for SEO canonicals, sitemaps, and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
